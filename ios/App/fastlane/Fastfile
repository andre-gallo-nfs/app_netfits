default_platform(:ios)

platform :ios do
  desc "Build and upload iOS app to TestFlight"
  lane :beta do
    key_id = ENV["APP_STORE_CONNECT_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
    key_file = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")

    UI.message("Connecting to App Store Connect API with Key ID: #{key_id}")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_file,
      in_house: false
    )

    create_keychain(
      name: "build_keychain",
      password: "netfits-temp-pass",
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    get_certificates(
      api_key: api_key,
      keychain_name: "build_keychain",
      keychain_password: "netfits-temp-pass"
    )

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "br.com.netfits.app",
      filename: "AppStore_br.com.netfits.app.mobileprovision"
    )

    update_project_provisioning(
      xcodeproj: "App.xcodeproj",
      profile: "AppStore_br.com.netfits.app.mobileprovision",
      target_filter: "App",
      build_configuration: "Release"
    )

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "Netfits.ipa",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
