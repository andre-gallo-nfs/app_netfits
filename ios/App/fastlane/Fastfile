default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight (Apple App Store)"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV['APP_STORE_CONNECT_KEY_ID']}.p8"),
      in_house: false
    )

    team_id = ENV["APPLE_TEAM_ID"]

    create_keychain(
      name: "build_keychain",
      password: "netfits-temp-pass",
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    target_keychain = File.expand_path("~/Library/Keychains/build_keychain-db")

    p12_path = "/tmp/p12/netfits-apple-distribution.p12"
    if File.exist?(p12_path)
      import_certificate(
        certificate_path: p12_path,
        certificate_password: "Netfits@2026!Apple",
        keychain_name: "build_keychain",
        keychain_password: "netfits-temp-pass"
      )
    end

    cert_args = {
      api_key: api_key,
      keychain_path: target_keychain,
      keychain_password: "netfits-temp-pass"
    }
    cert_args[:team_id] = team_id if team_id && !team_id.empty?
    get_certificates(cert_args)

    sigh_args = {
      api_key: api_key,
      app_identifier: "br.com.netfits.app",
      filename: "AppStore_br.com.netfits.app.mobileprovision"
    }
    sigh_args[:team_id] = team_id if team_id && !team_id.empty?
    get_provisioning_profile(sigh_args)

    update_project_provisioning(
      xcodeproj: "App.xcodeproj",
      profile: "AppStore_br.com.netfits.app.mobileprovision",
      target_filter: "App",
      build_configuration: "Release"
    )

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "Netfits.ipa",
      clean: true,
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "br.com.netfits.app" => (ENV["SIGH_NAME"] || "br.com.netfits.app AppStore")
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
