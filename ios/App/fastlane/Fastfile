default_platform(:ios)

platform :ios do
  desc "Build and upload iOS app to TestFlight"
  lane :beta do
    key_id = ENV["APP_STORE_CONNECT_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
    key_file = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")
    team_id = ENV["APPLE_TEAM_ID"] || "SA9P4PKNL8"

    UI.message("Connecting to App Store Connect API with Key ID: #{key_id}")
    UI.message("Key file exists: #{File.exist?(key_file)} (size: #{File.size(key_file) rescue 0} bytes)")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_file,
      in_house: false
    )

    keychain_path = create_keychain(
      name: "build_keychain",
      password: "netfits-temp-pass",
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    cert_args = {
      api_key: api_key,
      keychain_path: keychain_path,
      keychain_password: "netfits-temp-pass"
    }
    cert_args[:team_id] = team_id if team_id && !team_id.empty?
    get_certificates(cert_args)

    sigh_args = {
      api_key: api_key,
      app_identifier: "br.com.netfits.app",
      filename: "AppStore_br.com.netfits.app.mobileprovision"
    }
    sigh_args[:team_id] = team_id if team_id && !team_id.empty?
    get_provisioning_profile(sigh_args)

    update_project_provisioning(
      xcodeproj: "App.xcodeproj",
      profile: "AppStore_br.com.netfits.app.mobileprovision",
      target_filter: "App",
      build_configuration: "Release"
    )

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "Netfits.ipa",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
