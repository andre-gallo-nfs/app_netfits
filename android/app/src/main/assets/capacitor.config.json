{
	"appId": "br.com.netfits.app",
	"appName": "Netfits",
	"webDir": "dist",
	"bundledWebRuntime": false,
	"appendUserAgent": "NetfitsMobileApp",
	"server": {
		"url": "https://www.netfits.com.br/feed",
		"androidScheme": "https",
		"iosScheme": "https",
		"allowNavigation": [
			"netfits.com.br",
			"*.netfits.com.br",
			"*.mkplace.com.br",
			"*.vercel.app",
			"*.pages.dev",
			"*.supabase.co",
			"*.google-analytics.com",
			"*.googletagmanager.com",
			"*.analytics.google.com"
		]
	},
	"plugins": {
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#000000",
			"overlaysWebView": false
		},
		"Biometric": {
			"reason": "Autentique-se com Face ID / Digital para acessar sua conta Netfits"
		}
	}
}
