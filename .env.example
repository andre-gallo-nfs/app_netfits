# ==========================================
# Netfits — Variáveis de Ambiente & Conexões Externas
# ==========================================

# Google Analytics 4
VITE_GA4_MEASUREMENT_ID=G-NETFITS2026

# ==========================================
# Rock Encantech / Mkplace (Integração de Lojas - Stores)
# Fornecido pelo onboarding da Rock Encantech
# ==========================================
MKPLACE_ENV=sandbox
MKPLACE_STORE_ID=netfits-store-prod
MKPLACE_ACCOUNT_ID=netfits-acc-2026
MKPLACE_KEY_ID=nfs-mkplace-rsa-v1
MKPLACE_WEBVIEW_URL=https://shop.netfits.com.br
MKPLACE_WEBHOOK_SECRET=sec_nfs_mkplace_default_2026

# Chave Privada RSA (Formato PEM para assinatura RS256 dos tokens JWT)
# Dica: No ambiente Vercel / Cloudflare, cole com as quebras de linha substituídas por \n
MKPLACE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Chave Pública RSA (Formato PEM correspondente)
MKPLACE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
